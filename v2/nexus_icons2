local function DisplaySprite(imageLabel, map, index)
    local cols = math.floor(map.SheetW / map.IconW)
    imageLabel.Image           = map.AssetId
    imageLabel.ImageRectSize   = Vector2.new(map.IconW, map.IconH)
    imageLabel.ImageRectOffset = Vector2.new(
        map.IconW  * (index % cols),
        map.IconH  * math.floor(index / cols)
    )
end

local function DisplayByKey(imageLabel, map, key)
    local index = map.Keys[key]
    if index then
        DisplaySprite(imageLabel, map, index)
    else
        warn("[DarkDexIcons] Key no encontrado: " .. tostring(key))
    end
end

